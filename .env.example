# ---- Docker Compose (root) ----
# Public URL of the backend; short links look like ${BASE_URL}/abc123
BASE_URL=http://localhost:3000
# Where the React app is served (used for CORS and the "bikin link baru" button)
FRONTEND_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
# Set to true only behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
