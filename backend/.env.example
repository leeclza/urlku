PORT=3000
HOST=0.0.0.0
# SQLite file path, or postgres://user:pass@host:5432/urlku for PostgreSQL
DATABASE_URL=./db/urlku.db
BASE_URL=http://localhost:3000
# Comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_CREATE_PER_MINUTE=20
RATE_LIMIT_API_PER_MINUTE=120
TRUST_PROXY=false
# Auto-cleanup (0 = off / keep forever)
CLEANUP_INTERVAL_MINUTES=60
EXPIRED_LINK_RETENTION_DAYS=30
CLICK_RETENTION_DAYS=365
# development shows Kemal's detailed errors in logs; production hides them
KEMAL_ENV=development
